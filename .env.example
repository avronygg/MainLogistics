# Variables del sitio. En producción viven en Vercel; para probar en local,
# copiar a .env.local y completar. .env.local no se versiona.

# Clave de API de Resend (cuenta del cliente, donde logisticatrade.cl ya está
# verificado). Permiso "Sending access", dominio logisticatrade.cl.
RESEND_API_KEY=

# Remitente. Tiene que ser del dominio verificado en Resend o el envío se
# rechaza. Usar el mismo "From" que muestra Resend → Emails en los envíos de
# producción.
COTIZA_REMITENTE=

# Dirección del cotizador interno, sin barra final. El enlace "Armar la
# cotización con precios" de cada correo de solicitud apunta acá. Sin esta
# variable se usa la dirección escrita en app/api/solicitud/route.ts.
COTIZADOR_URL=

# El correo que RECIBE las solicitudes no es variable: está en
# components/datos/contacto.ts (CORREO).

# WhatsApp. Hoy está apagado (MOSTRAR_WHATSAPP = false en
# components/datos/contacto.ts). Esto solo sirve, con WhatsApp encendido,
# para apuntar un despliegue de prueba a otro número.
NEXT_PUBLIC_WHATSAPP=
